// Firestore security rules for MeeChain
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny all reads and writes
    // Add specific rules for badges, quests, and user data as needed
    
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Example rules for user data
    // match /users/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
    
    // Example rules for badges
    // match /badges/{badgeId} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null; // Add proper authorization
    // }
    
    // Example rules for quests
    // match /quests/{questId} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null; // Add proper authorization
    // }
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
      
      // User badges subcollection
      match /badges/{badgeId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only through cloud functions
      }
      
      // Completed quests subcollection
      match /completedQuests/{questId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only through cloud functions
      }
      
      // User stats
      match /stats/{statId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only through cloud functions
      }
    }
    
    // Quests collection
    match /quests/{questId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // Boards collection
    match /boards/{boardId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // Tasks collection (sub-collection of boards)
    match /boards/{boardId}/tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        get(/databases/$(database)/documents/boards/$(boardId)).data.userId == request.auth.uid;
    }
    
    // Badges collection
    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // Logs collection
    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only through cloud functions
    }
    
    // MeeBot logs
    match /meebotLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only through cloud functions
    }
    
    // External modules registry
    match /externalModules/{moduleId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Progress logs
    match /progress/{progressId} {
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Achievements
    match /achievements/{achievementId} {
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Voice events
    match /voiceEvents/{eventId} {
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      allow write: if false; // Only Cloud Functions can write
    }
    
    // External modules (public read, admin write)
    match /externalModules/{moduleId} {
      allow read: if true; // Public read
      allow write: if false; // Only admin can write
    }
  }
}
